<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!--
	  A bare Material3 parent. The real theme is defined in Compose
	  (InhumanTheme); this XML style only exists because the manifest needs
	  something to point at before Compose takes over, and because the system
	  draws the window background before the first frame.
	-->
	<style name="Theme.Inhuman" parent="android:Theme.Material.NoActionBar">
		<item name="android:windowBackground">@android:color/background_dark</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
	</style>
</resources>
