	<string name="settings_section_runtime">03 / 运行时</string>
	<string name="settings_runtime_title">演示与 SSH</string>
	<string name="settings_runtime_summary">无需密钥的脚本回复，以及远程 SSH 开关</string>
	<string name="settings_demo_title">演示模式</string>
	<string name="settings_demo_body">回复由设备本地按脚本生成，文件工具会真实执行；不会向任何地方发送内容，也不需要密钥。开启工具后，它会先创建一个文件再删除，因此不用账号也能完整跑通工具循环。</string>
	<string name="settings_ssh_title">SSH 工具</string>
	<string name="settings_ssh_body">默认关闭。开启后，可以给助手授予 SSH 工具：ssh_exec 执行命令，ssh_upload 和 ssh_download 传输文件。应用不会配置任何远程机器，助手使用你提供的地址和凭据。每个对话首次调用 SSH 时会显示授权提示，之后按普通工具策略执行。助手随后可以在远程机器上执行任意命令、替换文件，这些操作可能无法撤销。SSH 工具参数在写入记录前会脱敏，但你输入的文本仍会被保存。</string>
	<string name="settings_host_keys_none">还没有固定的主机密钥</string>
	<string name="settings_host_keys_count">已固定 %1$d 个主机密钥</string>
	<string name="settings_section_limits">04 / 轮次上限</string>
	<string name="settings_limits_title">工具上限</string>
	<string name="settings_limits_summary">每回合 %1$d 轮 · %2$d 次调用</string>
	<string name="settings_limits_body">所有对话共用的全局预算。一轮包含一次模型响应和它发起的工具调用；调用预算统计整个回合中的每次工具调用。两者都不改变可用的工具。</string>
	<string name="settings_rounds_per_turn">每回合轮次</string>
	<string name="settings_rounds_current">当前：每回合 %1$d 次模型/工具往返。</string>
	<string name="settings_calls_label">工具调用总数</string>
	<string name="settings_calls_current">当前：每回合 %1$d 次单独调用。任一预算用尽时，回合会停止并给出明确错误。</string>
	<string name="settings_section_backup">05 / 备份</string>
	<string name="settings_backup_title">备份</string>
	<string name="settings_backup_summary">数据与工作区的加密导出、导入</string>
	<string name="settings_backup_body">一个加密文件，包含所有对话、工作区文件、助手和规则。API 密钥不包含在内。</string>
	<string name="settings_export_backup">导出备份</string>
	<string name="settings_import_backup">导入备份</string>
	<string name="settings_undo_import">撤销上次导入</string>
	<string name="settings_backup_explain">导出时会要求设置口令，并生成一个加密文件。导入前会先展示文件内容。应用只会在重启后替换当前数据，旧数据会保留下来，可撤销一次。</string>
