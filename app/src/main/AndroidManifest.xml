<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!--
		The app's own clients talk to the configured model provider and the
		selected web search/fetch backend. The sandbox's "no network" guarantee
		applies to code the model writes, not to these calls; and it must be
		declared here rather than inherited from okhttp-android's manifest, which
		happens to merge the same permission today.
	-->
	<uses-permission android:name="android.permission.INTERNET" />
	<!--
		A turn can run for minutes, especially with tools, and the screen being
		off must not let Android kill the process halfway through a model call.
		The service is dataSync because the work is network I/O on the user's
		behalf; it stops as soon as isStreaming goes false.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!--
		Deliberately false. The Room database, every conversation workspace, the
		rollback snapshots and the diagnostic log are the user's private content;
		Android Auto Backup would upload them to the cloud without asking. The
		API key's ciphertext is Keystore-wrapped and unusable after a restore
		anyway. Migrating devices should be an explicit export, not an invisible
		backup — the same reason the workspace is `filesDir` and not `/sdcard`.
	-->
	<application
		android:name=".InhumanApp"
		android:allowBackup="false"
		android:localeConfig="@xml/locales_config"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.Inhuman">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:windowSoftInputMode="adjustResize"
			android:theme="@style/Theme.Inhuman">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<service
			android:name=".TurnForegroundService"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!--
			Exposes only the diagnostics directory, so Settings can hand the log
			to a share sheet. `exported=false` plus an app-private authority means
			no other app can read it without a granted URI.
		-->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.diagnostics"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/diagnostics_paths" />
		</provider>

	</application>

</manifest>
