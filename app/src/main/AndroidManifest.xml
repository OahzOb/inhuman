<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!--
		The app's own clients talk to api.deepseek.com: chat, model list, and the
		paid Search/Fetch APIs. The sandbox's "no network" guarantee applies to
		code the model writes, not to these calls; and it must be declared
		here rather than inherited from okhttp-android's manifest, which happens
		to merge the same permission today.
	-->
	<uses-permission android:name="android.permission.INTERNET" />

	<application
		android:name=".InhumanApp"
		android:allowBackup="true"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.Inhuman">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:windowSoftInputMode="adjustResize"
			android:theme="@style/Theme.Inhuman">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!--
			Exposes only the diagnostics directory, so Settings can hand the log
			to a share sheet. `exported=false` plus an app-private authority means
			no other app can read it without a granted URI.
		-->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.diagnostics"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/diagnostics_paths" />
		</provider>

	</application>

</manifest>
