# Build output and caches. Reproducible from the checked-in build files.
.gradle/
build/
*/build/
.kotlin/

# Screenshots produced by tools/build-and-shot.ps1. Useful to look at, not worth
# versioning -- they are regenerated on demand.
.shots/

# The SDK location, which differs per machine.
local.properties

# IDE state.
.idea/
*.iml
.DS_Store

# The QuickJS sandbox builds. Reproducible from jni/qjs_jni.c using
# _research/android-sandbox/build-qjs.ps1, which is checked in -- so these are
# build output like any other. Two megabytes of binary in a history that cannot
# shed it is a decision to make deliberately rather than by default.
_research/android-sandbox/out/
